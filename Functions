const fetch = require('node-fetch');  // Om du använder Node.js version där fetch inte finns globalt

exports.handler = async (event, context) => {
  try {
    // Förväntar oss att klienten skickar ett POST-request med en JSON-body med ett fält "userInput"
    const { userInput } = JSON.parse(event.body);

    // Gör ett anrop till OpenAI:s API med din API-nyckel som lagras i miljövariabeln APINYCKEL
    const response = await fetch("https://api.openai.com/v1/chat/completions", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        // API-nyckeln tas från process.env.APINYCKEL
        "Authorization": `Bearer ${process.env.APINYCKEL}`
      },
      body: JSON.stringify({
        model: "gpt-4-turbo",
        messages: [
          {
            role: "system",
            content: "Du är en kockassistent som ger familjevänliga recept med näringsfokus, inklusive blodsockersmarta tips och att alltid inkludera minst en grönsak."
          },
          {
            role: "user",
            content: `Jag har följande ingredienser: ${userInput}. Vad kan jag laga?`
          }
        ],
        max_tokens: 200
      })
    });

    // Omvandlar svaret till JSON-format
    const data = await response.json();

    // Returnera svaret till klienten
    return {
      statusCode: 200,
      body: JSON.stringify({ output: data.choices[0].message.content })
    };

  } catch (error) {
    console.error("Error fetching from OpenAI:", error);
    return {
      statusCode: 500,
      body: JSON.stringify({ error: "Något gick fel med API-anropet." })
    };
  }
};
